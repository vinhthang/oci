# Terraform local state and cache
.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup

# Sensitive variable files
terraform.tfvars
*.auto.tfvars

# Crash logs
crash.log
crash.*.log

# OS metadata
.DS_Store

# Hunter logs & state
hunt_arm.log
arm_instance.json
# WireGuard & Cryptographic Keys
*.key
*.conf
*private*
*public*
*client-qr*
wireguard/*.conf
!wireguard/*.conf.example
!wireguard/README.md
!docs/adr/*.md

# Helm secrets
charts/*/values.secrets.yaml

# Python / pytest cache
.pytest_cache/
__pycache__/
*.pyc

# Scratch & ephemeral agent files
patch-*.py
fix_*.py
fix.*
revert.py
extract.py
rg_output.txt
multi_pass_test.txt
test-alert*.json
