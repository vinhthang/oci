# 17. AI Review Server (Public Ingestion Telemetry + Central SSO Dashboard)
review.vinhthang.dev {
    import security_headers

    # Allow public healthcheck, llms.txt discovery, and static assets
    handle /api/health {
        reverse_proxy 10.0.0.216:30015 {
            import strip_auth_headers
            flush_interval -1
        }
    }
    handle /llms.txt {
        reverse_proxy 10.0.0.216:30015 {
            import strip_auth_headers
            flush_interval -1
        }
    }
    handle /api/llms.txt {
        reverse_proxy 10.0.0.216:30015 {
            import strip_auth_headers
            flush_interval -1
        }
    }
    handle /assets/* {
        reverse_proxy 10.0.0.216:30015 {
            import strip_auth_headers
            flush_interval -1
        }
    }

    # Allow authenticated webhook POST ingestion (raw-body HMAC / GitLab token verified in Fastify)
    @webhook {
        method POST
        path /api/v1/webhook/github /api/v1/webhook/gitlab /api/v1/webhook/forgejo
    }
    handle @webhook {
        request_body {
            max_size 10MB
        }
        reverse_proxy 10.0.0.216:30015 {
            import strip_auth_headers
            flush_interval -1
        }
    }

    # Allow authenticated API requests via Bearer Token for CLI/CI
    @api_auth {
        header Authorization "Bearer *"
        path /api/v1/*
    }
    handle @api_auth {
        reverse_proxy 10.0.0.216:30015 {
            import strip_auth_headers
            flush_interval -1
        }
    }

    # Protect the Private Web Review Dashboard with Google SSO
    handle {
        import sso_auth

        reverse_proxy 10.0.0.216:30015 {
            header_up X-Proxy-Auth-Secret {$PROXY_AUTH_SECRET}
            flush_interval -1
        }
    }
}

