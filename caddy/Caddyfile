# Global Security Headers Snippet
(security_headers) {
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
}

# 1. GitOps Automated Webhook Ingress (GitHub Webhook Receiver)
webhook.vinhthang.dev {
    import security_headers
    reverse_proxy 10.0.0.216:30009
}

# 2. Central OAuth2 SSO Portal
auth.vinhthang.dev {
    import security_headers
    reverse_proxy 10.0.0.216:30004
}

# 3. Primary Tech Blog (Hugo PaperMod Static Site)
vinhthang.dev, blog.vinhthang.dev, blog.thang-gcloud.duckdns.org {
    import security_headers
    root * /opt/hugo-blog/public
    file_server
    encode gzip zstd
}

# 4. Real-Time Uptime & Service Health Monitor (Unified Grafana 11 Dashboard)
status.vinhthang.dev {
    import security_headers
    reverse_proxy 10.0.0.216:30008 {
        flush_interval -1
    }
}

# 5. Grafana Unified Observability Dashboard (Central SSO Protected with Auth Proxy)
grafana.vinhthang.dev {
    import security_headers
    @no_auth not header Cookie *_oauth2_proxy*
    redir @no_auth https://auth.vinhthang.dev/oauth2/start?rd=https://{host}{uri}

    forward_auth 10.0.0.216:30004 {
        uri /oauth2/auth
        copy_headers X-Auth-Request-User X-Auth-Request-Email
    }

    reverse_proxy 10.0.0.216:30008 {
        header_up X-Auth-Request-Email {http.reverse_proxy.header.X-Auth-Request-Email}
        header_up X-Auth-Request-User {http.reverse_proxy.header.X-Auth-Request-User}
        flush_interval -1
    }
}

# 6. Umami Privacy-Friendly Web Analytics (Central SSO Protected Dashboard)
analytics.vinhthang.dev, analytic.vinhthang.dev {
    import security_headers
    # Allow anonymous public telemetry collection for blog stats
    @public_telemetry path /script.js /api/send* /_next/*
    handle @public_telemetry {
        reverse_proxy 10.0.0.216:30003
    }

    # Protect the Private Analytics Dashboard with Google SSO
    handle {
        @no_auth not header Cookie *_oauth2_proxy*
        redir @no_auth https://auth.vinhthang.dev/oauth2/start?rd=https://{host}{uri}

        forward_auth 10.0.0.216:30004 {
            uri /oauth2/auth
            copy_headers X-Auth-Request-User X-Auth-Request-Email
        }

        reverse_proxy 10.0.0.216:30003
    }
}

