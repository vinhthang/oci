# 11. FileBrowser Personal Cloud Storage (Central SSO Protected)
files.vinhthang.dev {
    import security_headers
    @no_auth not header Cookie *_oauth2_proxy*
    redir @no_auth https://auth.vinhthang.dev/oauth2/start?rd=https://{host}{uri}

    forward_auth 10.0.0.216:30004 {
        uri /oauth2/auth
        copy_headers X-Auth-Request-User X-Auth-Request-Email
    }

    request_body {
        max_size 20GB
    }
    reverse_proxy 10.0.0.10:8082 {
        flush_interval -1
    }
}

